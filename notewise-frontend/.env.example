# Template for the frontend's environment variables.
#
# Next.js automatically loads .env.development when running `next dev` and
# .env.production when running `next build`/`next start` — no extra config
# needed. Copy this file to .env.development or .env.production and fill in
# real values.
#
#   cp .env.example .env.development

NEXT_PUBLIC_ENTRA_TENANT_NAME=<entra-tenant-name>
NEXT_PUBLIC_ENTRA_TENANT_ID=<entra-tenant-id>
NEXT_PUBLIC_SPA_CLIENT_ID=<spa-app-client-id>
NEXT_PUBLIC_API_CLIENT_ID=<api-app-client-id>
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
