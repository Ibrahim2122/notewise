# Template for the backend's environment variables.
#
# Copy this file to .env.development (local dev) or .env.production
# (production) and fill in real values. Which file gets loaded is controlled
# by the ENVIRONMENT variable — see app/config.py.
#
#   cp .env.example .env.development
#   export ENVIRONMENT=development   # default, can be omitted locally

# Postgres connection string (SQLAlchemy + psycopg2 driver)
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>?sslmode=require

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_CONNECTION_STRING=<storage-account-connection-string>
AZURE_BLOB_CONTAINER=notewise-dev

# Local-only fallback user id used when auth is bypassed. Leave unset in production.
DEV_USER_ID=dev-user

# Microsoft Entra External ID (CIAM) app registration
ENTRA_TENANT_ID=<entra-tenant-id>
ENTRA_TENANT_NAME=<entra-tenant-name>
API_CLIENT_ID=<api-app-client-id>

# Comma-separated list of origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# LLM provider — at least one is required; OPENROUTER_API_KEY is tried first
OPENROUTER_API_KEY=<openrouter-api-key>
GEMINI_API_KEY=<gemini-api-key>
